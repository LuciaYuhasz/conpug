{
    "version": 2,
    "functions": {
        "api/app.js": {
            "runtime": "nodejs"
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "api/app.js"
        },
        {
            "src": "/(.*)",
            "dest": "api/app.js"
        }
    ]
}